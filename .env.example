# TopCam — variáveis de ambiente.
# Gere um .env com segredos aleatórios:  ./scripts/generate-env.sh
# Nunca versione o .env.

# ---- identificação pública (use o hostname definitivo desde o piloto)
PUBLIC_HOST=video.seudominio.com.br
RTMP_PUBLIC_PORT=1935
RTMPS_PUBLIC_PORT=1936
HTTP_PORT=80
HTTPS_PORT=443
# Endereço do painel: ":80" = só HTTP (laboratório). Com o domínio, HTTPS automático.
# Use scripts/https.sh para ligar (ajusta também PANEL_URL, COOKIE_SECURE e WEBRTC_HOSTS).
SITE_ADDRESS=:80
HTTP_REDIRECT_ADDRESS=http://redirecionamento.invalid
# Endereço do painel nos e-mails (padrão: http://PUBLIC_HOST)
PANEL_URL=
# Endereços anunciados para o WebRTC (padrão: PUBLIC_HOST). Ex.: topcam.suportinet.com.br,172.31.141.20
WEBRTC_HOSTS=
# RTMPS na porta 1936: no | optional (ligue só depois do certificado emitido)
RTMP_ENCRYPTION=no
# Interfaces onde as portas são publicadas (0.0.0.0 = todas)
RTMP_BIND=0.0.0.0
HTTP_BIND=0.0.0.0
# Mídia WebRTC do ao vivo (porta 8189 UDP/TCP, fixa)
WEBRTC_BIND=0.0.0.0

# ---- segredos (gerados pelo scripts/generate-env.sh)
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
MEDIA_HOOK_SECRET=
MEDIA_READ_PASSWORD=
# Token do gateway para ler o ao vivo (cam/<id>) no servidor de mídia
MEDIA_GATEWAY_TOKEN=
# Segredo dos tokens de acesso do painel/app
JWT_SECRET=
# 32 bytes em base64 — cifra as chaves RTMP e a senha do SMTP no banco. Guarde cópia segura.
# Para trocar (recifra o banco): scripts/rotate-secrets.sh --enc
STREAM_KEY_ENC_KEY=

# Cookie de sessão só por HTTPS (scripts/https.sh liga junto com o HTTPS)
COOKIE_SECURE=false

# ---- limites (Fase 8). Rede interna (172.16.0.0/12) e redes do firewall ficam fora do limite geral.
# Requisições por minuto por IP na API (0 desliga)
RATE_LIMIT_API_PER_MIN=1200
# Chaves de câmera erradas por IP em 10 min antes do bloqueio, e duração do bloqueio (s)
PUBLISH_BADKEY_MAX=20
PUBLISH_BADKEY_BLOCK_S=1800

# ---- administrador inicial (a senha deverá ser trocada no primeiro acesso — Fase 2)
ADMIN_EMAIL=admin@seudominio.com.br
ADMIN_INITIAL_PASSWORD=

# ---- dados de demonstração (2 clientes fictícios e 5+1 câmeras). Use false em produção.
SEED_DEMO=true

# ---- gravações: disco de vídeo dedicado (35 GB) montado pelo infra/vm/prepare-vm.sh
RECORDINGS_DIR=/srv/topcam/recordings
# Quota de vídeo em bytes (opcional; usada a partir da Fase 6)
VIDEO_QUOTA_BYTES=

# ---- monitoramento de câmeras
POLL_INTERVAL_S=5
OFFLINE_AFTER_S=10

LOG_LEVEL=info
TOPCAM_VERSION=0.1.0
